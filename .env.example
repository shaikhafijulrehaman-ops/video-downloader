# Server Configuration
PORT=3001
NODE_ENV=production

# Security & Rate Limiting
# 20 requests per IP per 10 minutes (600000 ms)
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX=20

# CORS Allowed Origins (comma-separated or * in development)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173,http://localhost:3000

# Optional External Media Resolver API Keys (RapidAPI for 100% public MP4 video resolution)
# RAPIDAPI_KEY=your_rapidapi_key_here
# RAPIDAPI_HOST=instagram-downloader-download-instagram-videos-stories.p.rapidapi.com
